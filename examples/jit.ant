-[ jit.ant : [[jit]] 标记 —— 超指令 + 机器码后端

   `[[jit]]` 只表示“这段请提前优化”。解释器在加载时先做超指令融合（比较+分支、
   x 自增、a[i] += k 等），如果整个函数都落在整数子集里，再把它翻译成 x86-64 机器码；
   翻译不了就照常解释执行，所以标记永远不会改变程序的含义。

   下面每条都用“同一个函数，一个带标记、一个不带”来对照，结果（含 typeof）必须完全一致。
]-

use std
use test

Test.suite("jit: 机器码后端")

[[jit]]
sum_jit(n:int64)(
    new s = 0
    new i = 0
    while i < n(
        s = s + i
        i = i + 1
    )
    =s
)

sum_plain(n)(
    new s = 0
    new i = 0
    while i < n(
        s = s + i
        i = i + 1
    )
    =s
)

-- 带类型提示的同款函数：给参数标注类型后，传浮点会按声明类型转换，
-- 所以"浮点参数回退解释器"要和它比较（而不是和未标注的 sum_plain 比）
sum_int_plain(n:int64)(
    new s = 0
    new i = 0
    while i < n(
        s = s + i
        i = i + 1
    )
    =s
)

[[jit]]
count_jit(n:int64)(
    new i = 0
    while i < n(
        i = i + 1
    )
    =i
)

[[jit]]
sum_even_jit(n:int64)(
    new s = 0
    new i = 0
    -- 步长 2 累加偶数：与下面用 `i % 2` 的写法结果相同，但取模不在机器码后端的指令集里
    while i < n(
        s = s + i
        i = i + 2
    )
    =s
)

sum_even_plain(n)(
    new s = 0
    for i in 0 to n - 1(
        if i % 2 == 0(
            s = s + i
        )
    )
    =s
)

-- 递归函数不是整数直线子集（有自调用），[[jit]] 会安静地回退解释器
[[jit]]
fact_jit(n:int64)(
    if n <= 1( =1 )
    =n * fact_jit(n - 1)
)

-- 1. 逐个输入对照：值与类型都必须和解释器一致
new same = true
for n in 0 to 250(
    if sum_jit(n) != sum_plain(n)( same = false )
    if typeof(sum_jit(n)) != typeof(sum_plain(n))( same = false )
    if count_jit(n) != n( same = false )
    if sum_even_jit(n) != sum_even_plain(n)( same = false )
)
Test.eq(same, true, "0..250 与解释器逐项一致（含 typeof）")
Test.eq(sum_jit(1000), 499500, "1000 求和")
Test.eq(count_jit(1000), 1000, "计数循环")
Test.eq(sum_even_jit(100), 2450, "带 if 的循环")
Test.eq(fact_jit(10), 3628800, "递归自动回退解释器")

-- 2. 参数类型不满足整数子集时不崩溃、语义不变
Test.eq(sum_jit(1.5), sum_int_plain(1.5), "浮点参数回退解释器")
Test.eq(sum_jit(10.75), sum_int_plain(10.75), "浮点参数结果一致")

-- 3. 性能：同一份循环，标记前后
new n = 400000
new t0 = _sys_clock()
new r1 = sum_plain(n)
new t1 = _sys_clock()
new r2 = sum_jit(n)
new t2 = _sys_clock()
Test.eq(r1 == r2, true, "结果一致")
print ""
print "循环 40 万次 (解释器) ->", t1 - t0, "ms"
print "循环 40 万次 ([[jit]]) ->", t2 - t1, "ms"

Test.suite("自动 JIT（完全不写标注）")

-- 这个函数没有任何标注：循环跑热了会自己编译成机器码并在循环头接管
sum_auto(n)(
    new s = 0
    new i = 0
    while i < n(
        s = s + i
        i = i + 1
    )
    =s
)

Test.eq(sum_auto(10), 45, "小输入结果正确")
Test.eq(sum_auto(100000), 4999950000, "大输入结果正确")
new t0 = _sys_clock()
new auto_a = sum_auto(2000000)
new t1 = _sys_clock()
new auto_b = sum_auto(2000000)
new t2 = _sys_clock()
Test.eq(auto_a == auto_b, true, "两次结果一致")
Test.eq(auto_a, 1999999000000, "自动 JIT 的结果正确")
print ""
print "自动 JIT 第一次 ->", t1 - t0, "ms"
print "自动 JIT 第二次 ->", t2 - t1, "ms"

Test.suite("JIT：除法、宽度、print、区间与全局量")

-- 除法和取模由 C 辅助函数负责语义，机器码只检查除数是否为零
[[jit]]
div_jit(a:int64, b:int64)(
    new q = a / b
    new r = a % b
    =q * 1000000 + r
)
div_plain(a, b)(
    new q = a / b
    new r = a % b
    =q * 1000000 + r
)
Test.eq(div_jit(-17, 5), div_plain(-17, 5), "除法取模与解释器一致")
Test.eq(div_jit(-17, 5), -3000002, "-17/5 与 -17%5")
Test.eq(div_jit(17, -5), div_plain(17, -5), "负除数一致")

-- 每个声明宽度都必须原样穿过机器码（回绕和 typeof 都要一致）
[[jit]]
widths_jit(n:int64)(
    new a: int8 = int8(n)
    new b: uint32 = uint32(n)
    new c: uint64 = uint64(n)
    print(a, b, c)
    print(a < b, b < c, a == a)
    =int64(a)
)
widths_plain(n)(
    new a: int8 = int8(n)
    new b: uint32 = uint32(n)
    new c: uint64 = uint64(n)
    print(a, b, c)
    print(a < b, b < c, a == a)
    =int64(a)
)
Test.eq(widths_jit(300), widths_plain(300), "窄宽度回绕一致")
Test.eq(typeof(widths_jit(300)), typeof(widths_plain(300)), "窄宽度 typeof 一致")
Test.eq(widths_jit(300), 44, "300 收进 int8 是 44")

-- 区间迭代：机器码把迭代器状态放在自己的私有槽里
[[jit]]
range_jit(n:int64)(
    new total = 0
    for i in 1 to n(
        for j in 1 to 3(
            total = total + i * j
        )
    )
    =total
)
range_plain(n)(
    new total = 0
    for i in 1 to n(
        for j in 1 to 3(
            total = total + i * j
        )
    )
    =total
)
Test.eq(range_jit(100), range_plain(100), "区间迭代（嵌套）一致")
Test.eq(range_jit(100), 30300, "区间迭代结果")
Test.eq(range_jit(0), 0, "空区间")
Test.eq(range_jit(1), 6, "单次迭代")

-- 全局量：机器码读它、写它，值必须和解释器一模一样
new gtotal = 0
new gcount = 0
[[jit]]
user_shape(n:int64)(
    for i in 1 to n(
        gtotal = gtotal + i
        gcount = gcount + 1
    )
    print("gtotal", gtotal, "gcount", gcount)
    =gtotal
)
Test.eq(user_shape(1000), 500500, "全局量累加（机器码里写全局量）")
Test.eq(gcount, 1000, "全局量计数")
Test.eq(gtotal, 500500, "全局量在调用结束后可见")
print "全局量在 [[jit]] 函数里被改写：", gtotal, gcount
Test.eq(user_shape(0), gtotal, "零次迭代不改动全局量")

Test.suite("自动 JIT：区间循环的中途接管")

-- 没有标注：区间循环跑热之后在 iter_next 处直接换成机器码（栈上还留着迭代器）
range_auto(n)(
    new total = 0
    for i in 1 to n(
        total = total + i
    )
    =total
)
Test.eq(range_auto(10), 55, "小输入正确")
Test.eq(range_auto(2000000), 2000001000000, "大输入（中途接管）正确")


Test.suite("JIT: width matrix (every declared width, machine code vs interpreter)")

[[jit]]
n_Int8(a:int8, b:int8)(
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
p_Int8(a, b)(
    a = int8(a)
    b = int8(b)
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
for v in [0, -1, 300, 2147483647, 4294967295, -1000000007](
    Test.eq(n_Int8(v, 3), p_Int8(v, 3), "int8 b=3 v=" + str(v))
    Test.eq(n_Int8(v, 0 - 1), p_Int8(v, 0 - 1), "int8 b=-1 v=" + str(v))
    Test.eq(n_Int8(v, v), p_Int8(v, v), "int8 a=b v=" + str(v))
)
[[jit]]
n_Int16(a:int16, b:int16)(
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
p_Int16(a, b)(
    a = int16(a)
    b = int16(b)
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
for v in [0, -1, 300, 2147483647, 4294967295, -1000000007](
    Test.eq(n_Int16(v, 3), p_Int16(v, 3), "int16 b=3 v=" + str(v))
    Test.eq(n_Int16(v, 0 - 1), p_Int16(v, 0 - 1), "int16 b=-1 v=" + str(v))
    Test.eq(n_Int16(v, v), p_Int16(v, v), "int16 a=b v=" + str(v))
)
[[jit]]
n_Int32(a:int32, b:int32)(
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
p_Int32(a, b)(
    a = int32(a)
    b = int32(b)
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
for v in [0, -1, 300, 2147483647, 4294967295, -1000000007](
    Test.eq(n_Int32(v, 3), p_Int32(v, 3), "int32 b=3 v=" + str(v))
    Test.eq(n_Int32(v, 0 - 1), p_Int32(v, 0 - 1), "int32 b=-1 v=" + str(v))
    Test.eq(n_Int32(v, v), p_Int32(v, v), "int32 a=b v=" + str(v))
)
[[jit]]
n_Int64(a:int64, b:int64)(
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
p_Int64(a, b)(
    a = int64(a)
    b = int64(b)
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
for v in [0, -1, 300, 2147483647, 4294967295, -1000000007](
    Test.eq(n_Int64(v, 3), p_Int64(v, 3), "int64 b=3 v=" + str(v))
    Test.eq(n_Int64(v, 0 - 1), p_Int64(v, 0 - 1), "int64 b=-1 v=" + str(v))
    Test.eq(n_Int64(v, v), p_Int64(v, v), "int64 a=b v=" + str(v))
)
[[jit]]
n_Uint8(a:uint8, b:uint8)(
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
p_Uint8(a, b)(
    a = uint8(a)
    b = uint8(b)
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
for v in [0, -1, 300, 2147483647, 4294967295, -1000000007](
    Test.eq(n_Uint8(v, 3), p_Uint8(v, 3), "uint8 b=3 v=" + str(v))
    Test.eq(n_Uint8(v, 0 - 1), p_Uint8(v, 0 - 1), "uint8 b=-1 v=" + str(v))
    Test.eq(n_Uint8(v, v), p_Uint8(v, v), "uint8 a=b v=" + str(v))
)
[[jit]]
n_Uint16(a:uint16, b:uint16)(
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
p_Uint16(a, b)(
    a = uint16(a)
    b = uint16(b)
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
for v in [0, -1, 300, 2147483647, 4294967295, -1000000007](
    Test.eq(n_Uint16(v, 3), p_Uint16(v, 3), "uint16 b=3 v=" + str(v))
    Test.eq(n_Uint16(v, 0 - 1), p_Uint16(v, 0 - 1), "uint16 b=-1 v=" + str(v))
    Test.eq(n_Uint16(v, v), p_Uint16(v, v), "uint16 a=b v=" + str(v))
)
[[jit]]
n_Uint32(a:uint32, b:uint32)(
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
p_Uint32(a, b)(
    a = uint32(a)
    b = uint32(b)
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
for v in [0, -1, 300, 2147483647, 4294967295, -1000000007](
    Test.eq(n_Uint32(v, 3), p_Uint32(v, 3), "uint32 b=3 v=" + str(v))
    Test.eq(n_Uint32(v, 0 - 1), p_Uint32(v, 0 - 1), "uint32 b=-1 v=" + str(v))
    Test.eq(n_Uint32(v, v), p_Uint32(v, v), "uint32 a=b v=" + str(v))
)
[[jit]]
n_Uint64(a:uint64, b:uint64)(
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
p_Uint64(a, b)(
    a = uint64(a)
    b = uint64(b)
    new s = a + b
    new d = a * 3 - b
    new q = a / (b - 2)
    new r = a % (b - 2)
    if a < b( =s + 1 )
    =d + q * 1000 + r - s
)
for v in [0, -1, 300, 2147483647, 4294967295, -1000000007](
    Test.eq(n_Uint64(v, 3), p_Uint64(v, 3), "uint64 b=3 v=" + str(v))
    Test.eq(n_Uint64(v, 0 - 1), p_Uint64(v, 0 - 1), "uint64 b=-1 v=" + str(v))
    Test.eq(n_Uint64(v, v), p_Uint64(v, v), "uint64 a=b v=" + str(v))
)


Test.suite("JIT: 128 bit (longlong) arithmetic in machine code")

new wx: longlong = 9223372036854775808
new wy: longlong = 9223372036854775811

[[jit]]
wa_add()(
    new x = wx
    new y = wy
    new r = x + y
    =r
)
wv_add()(
    new x = wx
    new y = wy
    new r = x + y
    =r
)
Test.eq(wa_add(), wv_add(), "add on longlong matches the interpreter")
Test.eq(typeof(wa_add()), typeof(wv_add()), "add longlong typeof")
[[jit]]
wa_sub()(
    new x = wx
    new y = wy
    new r = x - y
    =r
)
wv_sub()(
    new x = wx
    new y = wy
    new r = x - y
    =r
)
Test.eq(wa_sub(), wv_sub(), "sub on longlong matches the interpreter")
Test.eq(typeof(wa_sub()), typeof(wv_sub()), "sub longlong typeof")
[[jit]]
wa_mul()(
    new x = wx
    new y = wy
    new r = x * y
    =r
)
wv_mul()(
    new x = wx
    new y = wy
    new r = x * y
    =r
)
Test.eq(wa_mul(), wv_mul(), "mul on longlong matches the interpreter")
Test.eq(typeof(wa_mul()), typeof(wv_mul()), "mul longlong typeof")
[[jit]]
wa_div()(
    new x = wx
    new y = wy
    new r = x / y
    =r
)
wv_div()(
    new x = wx
    new y = wy
    new r = x / y
    =r
)
Test.eq(wa_div(), wv_div(), "div on longlong matches the interpreter")
Test.eq(typeof(wa_div()), typeof(wv_div()), "div longlong typeof")
[[jit]]
wa_mod()(
    new x = wx
    new y = wy
    new r = x % y
    =r
)
wv_mod()(
    new x = wx
    new y = wy
    new r = x % y
    =r
)
Test.eq(wa_mod(), wv_mod(), "mod on longlong matches the interpreter")
Test.eq(typeof(wa_mod()), typeof(wv_mod()), "mod longlong typeof")
[[jit]]
wa_lt()(
    new x = wx
    new y = wy
    new r = x < y
    =r
)
wv_lt()(
    new x = wx
    new y = wy
    new r = x < y
    =r
)
Test.eq(wa_lt(), wv_lt(), "lt on longlong matches the interpreter")
Test.eq(typeof(wa_lt()), typeof(wv_lt()), "lt longlong typeof")
[[jit]]
wa_le()(
    new x = wx
    new y = wy
    new r = x <= y
    =r
)
wv_le()(
    new x = wx
    new y = wy
    new r = x <= y
    =r
)
Test.eq(wa_le(), wv_le(), "le on longlong matches the interpreter")
Test.eq(typeof(wa_le()), typeof(wv_le()), "le longlong typeof")
[[jit]]
wa_gt()(
    new x = wx
    new y = wy
    new r = x > y
    =r
)
wv_gt()(
    new x = wx
    new y = wy
    new r = x > y
    =r
)
Test.eq(wa_gt(), wv_gt(), "gt on longlong matches the interpreter")
Test.eq(typeof(wa_gt()), typeof(wv_gt()), "gt longlong typeof")
[[jit]]
wa_eq()(
    new x = wx
    new y = wy
    new r = x == y
    =r
)
wv_eq()(
    new x = wx
    new y = wy
    new r = x == y
    =r
)
Test.eq(wa_eq(), wv_eq(), "eq on longlong matches the interpreter")
Test.eq(typeof(wa_eq()), typeof(wv_eq()), "eq longlong typeof")
[[jit]]
wa_ne()(
    new x = wx
    new y = wy
    new r = x != y
    =r
)
wv_ne()(
    new x = wx
    new y = wy
    new r = x != y
    =r
)
Test.eq(wa_ne(), wv_ne(), "ne on longlong matches the interpreter")
Test.eq(typeof(wa_ne()), typeof(wv_ne()), "ne longlong typeof")

-- the motivating shape: a wide global accumulating in a loop, with print inside the function
new wg: longlong = 9223372036854775808
new wm: longlong = 9223372037854775815
[[jit]]
w_grow(n:int64)(
    for i in 1 to n(
        wg = wg * 3
        if wg >= wm( wg = wg - wm )
    )
    print("wg", wg)
    =wg
)
Test.eq(w_grow(50), 112964362914285000563608145710095104708, "wide global: multiply, compare, subtract")
Test.eq(wg, 112964362914285000563608145710095104708, "the value machine code wrote is visible to the interpreter")

Test.check()
