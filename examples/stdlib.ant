-[ 标准库导览：use std 一次载入全部模块 ]-

use std

—分段 序列 Seq

print Seq.map([1, 2, 3, 4], (x)( =x * x ))
print Seq.filter([1, 2, 3, 4, 5], (x)( =x % 2 == 1 ))
print Seq.reduce([1, 2, 3, 4], (a, b)( =a + b ), 0)
print Seq.sort([5, 3, 8, 1]), Seq.sort(["pear", "apple"], reverse=true)
print Seq.unique([1, 2, 2, 3, 1]), Seq.flatten([[1], [2, 3]])
print Seq.take([1, 2, 3, 4], 2), Seq.drop([1, 2, 3, 4], 2)
print Seq.chunk([1, 2, 3, 4, 5], 2)
print Seq.min_of([4, 2, 9]), Seq.max_of([4, 2, 9]), Seq.sum_of([1, 2, 3])
print Seq.any([1, 2, 3], (x)( =x > 2 )), Seq.all([1, 2, 3], (x)( =x > 0 ))
print Seq.join(["a", "b", "c"], " / ")

—分段 字符串 Str

print Str.format("{} has {} items", "cart", 3)
print Str.pad_left("42", 6, "0"), "[" + Str.center("hi", 8, "*") + "]"
print Str.capitalize("hELLO"), Str.title("the quick fox"), Str.reverse("abc")
print Str.repeat("-", 10), Str.count("mississippi", "ss"), Str.hex(48879)
print Str.lines("  one  " + chr(10) + "two"), Str.is_digit("2024")

—分段 字典 Dict

new scores = Dict()
scores.set("alice", 91)
scores.set("bob", 78)
scores.set("carol", 85)
print scores, len(scores)
print scores.get("alice"), scores.get("dave", 0)
print scores.has("bob"), scores.keys_sorted()
for (name, score) in scores.items()(
    if score >= 85(
        print "  " + name + " passed with " + score
    )
)

—分段 数学 Mathx

print Mathx.gcd(1071, 462), Mathx.lcm(21, 6), Mathx.factorial(10)
print Mathx.primes(40)
print Mathx.is_prime(9973), Mathx.digit_sum(98765)
print Mathx.clamp(120, 0, 100), Mathx.round_to(3.14159, 3)
print Mathx.mean([2, 4, 6, 8]), Mathx.median([7, 1, 5, 3]), Mathx.stddev([2, 4, 4, 4, 5, 5, 7, 9])

—分段 切片 slice

new data = [10, 20, 30, 40, 50, 60]
new middle = data[1:4]
print middle, middle.size(), middle.get(0), middle.to_list()
print data[4:].to_list(), data[:2].to_list(), data[:].size()

—分段 断言 Test

Test.suite("stdlib 导览")
Test.eq(Seq.sum_of([1, 2, 3]), 6, "sum_of")
Test.eq(Str.format("{}-{}", "a", "b"), "a-b", "format")
Test.eq(Mathx.gcd(12, 18), 6, "gcd")
Test.eq(scores.get("alice"), 91, "dict get")
Test.near(Mathx.mean([1, 2, 3]), 2.0, 0.000001, "mean")
Test.check()
