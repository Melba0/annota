-[ arrays.ant : 定长 / 类型化数组，128 位常量 ]-

use std

Test.suite("数组")

-- ---------------------------------------------------------------- 定长数组
new a:int[5] = [1, 2]
Test.eq(len(a), 5, "定长数组长度")
Test.eq(a[0], 1, "自动补 0 之前的元素")
Test.eq(a[4], 0, "自动补 0")
Test.eq(a[2], 0, "中间补 0")

new z:int[3]
Test.eq(len(z), 3, "无初值也可声明")
Test.eq(z[1], 0, "默认补 0")

-- ---------------------------------------------------------------- 多维：连续存储 + 行视图
new m:int[3][4]
Test.eq(len(m), 3, "第一维长度")
Test.eq(len(m[1]), 4, "第二维长度")
m[1][2] = 7
Test.eq(m[1][2], 7, "行视图写回父数组")
Test.eq(m[2][0], 0, "其他行不受影响")

-- ---------------------------------------------------------------- 动态数组元素类型
new d:int[] = []
d.push(1)
d.push(2)
Test.eq(len(d), 2, "T[] 可增长")
Test.eq(d[1], 2, "索引")
d[0] = 9
Test.eq(d[0], 9, "写回")

-- ---------------------------------------------------------------- 带元素类型的字符串数组
new names:String[3] = ["a"]
Test.eq(names[0], "a", "字符串元素")
Test.eq(names[2], "", "字符串补空串")

-- ---------------------------------------------------------------- 遍历与赋值语义（深拷贝）
new src:int[3] = [1, 2, 3]
new copy:int[3] = [0]
new total = 0
for x in src( total = total + x )
Test.eq(total, 6, "遍历数组")
copy.set(0, 99)
Test.eq(src[0], 1, "数组赋值是深拷贝")

-- ---------------------------------------------------------------- 128 位字面量与算术
new big = 170141183460469231731687303715884105727
Test.eq(typeof(big), "longlong", "超大常量成为 128 位")
Test.eq(big + 1, longlong("-170141183460469231731687303715884105728"), "128 位回绕")
Test.eq(0xFFFFFFFFFFFFFFFF + 1, longlong("18446744073709551616"), "超大十六进制常量")
Test.eq(int(big / 170141183460469231731687303715884105727), 1, "128 位除法")

-- ---------------------------------------------------------------- 静态可证 + [[unsafe]] 省掉检查
[[unsafe]]
hot(arr, i)(
    =arr[i]
)
new buf:int[4] = [1, 2, 3, 4]
Test.eq(hot(buf, 3), 4, "[[unsafe]] 下标跳过运行时检查")
Test.eq(buf[0] + buf[3], 5, "常量下标由编译器证明")

Test.check()
